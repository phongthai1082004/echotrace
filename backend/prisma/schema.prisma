generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ExpenseCategory {
  OPERATING  // Hạ tầng, Server, Văn phòng
  PAYROLL    // Lương, Thưởng
  MARKETING  // Ads, Seeding, PR
  DEBT       // Trả nợ Supplier, Vay ngoài, Vay ngân hàng
  OTHER
}

model User {
  id       Int     @id @default(autoincrement())
  email    String? @unique
  password String?
  name     String?
  avatar   String?
  phone    String?
  address  String?
  city     String?
  role     String  @default("user")
  googleId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  tokens      Token[]
  orders      Order[]
  userImages  UserImage[]
  books       Book[]
  couponUsage CouponUsage[]
  sampleBooks SampleBook[]
  decorAssets DecorAsset[]
  cart        Cart?
  expenses    Expense[]

  @@index([role])
  @@index([isDelete])
}

model Token {
  id           Int      @id @default(autoincrement())
  userId       Int?
  email        String?
  refreshToken String   @unique
  tokenType    String   @default("session")
  isRevoked    Boolean  @default(false)
  expiresAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  user         User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([email])
  @@index([expiresAt])
}

model UserImage {
  id       Int    @id @default(autoincrement())
  userId   Int
  url      String
  publicId String
  width    Int?
  height   Int?
  size     Int?
  bookId   Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  user     User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([bookId])
}

model Order {
  id             Int      @id @default(autoincrement())
  orderCode      String?
  userId         Int
  supplierId     Int?
  subTotal       Float
  totalAmount    Float
  depositAmount  Float    @default(0)
  paidAmount     Float    @default(0)
  paymentType    String   @default("FULL")
  paymentStatus  String   @default("UNPAID")
  status         String   @default("PENDING_PAYMENT")
  name           String?
  phone          String?
  address        String?
  city           String?
  note           String?
  couponId       Int?
  discountAmount Float    @default(0)
  orderShippingFee    Float?   
  supplierShippingFee Float?   
  trackingCode      String?
  orderItems     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  user         User          @relation(fields: [userId], references: [id])
  supplier     Supplier?     @relation(fields: [supplierId], references: [id])
  coupon       Coupon?       @relation(fields: [couponId], references: [id])
  transactions Transaction[]
  expenses     Expense[]

  @@index([userId])
  @@index([supplierId])
  @@index([couponId])
  @@index([status])
  @@index([paymentStatus])
  @@index([orderCode])
  @@index([trackingCode])
}

// gateway: PAYOS | SEPAY | MANUAL | CASH ...
// type: DEPOSIT | REMAINING_PAYMENT | FULL_PAYMENT
model Transaction {
  id                     Int      @id @default(autoincrement())
  orderId                Int
  gateway                String
  gatewayTransactionCode String   @unique
  type                   String   @default("FULL_PAYMENT")
  amount                 Float
  paymentLinkId          String?
  bankAccount            String?
  content                String?
  reference              String?
  status                 String
  transactionTime        DateTime
  rawPayload             Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  order           Order    @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@index([gateway])
  @@index([type])
}

// orderItems: JSON snapshot of books at order time, like Cart.items.
// OrderItem table was replaced by this column — one row per order, items stored as JSON string.
model Book {
  id          Int     @id @default(autoincrement())
  userId      Int
  type        String  @default("TRAVEL")
  title       String
  style       String
  font        String
  cover       String  @default("softcover")
  coverUrl    String?
  paperHeight Float?
  paperWidth  Float?

  content   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  user       User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  items     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model SampleBook {
  id          Int     @id @default(autoincrement())
  createdBy   Int
  name        String
  description String?
  type        String  @default("TRAVEL")
  category    String?
  style       String
  font        String
  cover       String  @default("softcover")
  coverUrl    String?
  paperHeight Float?
  paperWidth  Float?
  isActive    Boolean @default(true)
  content     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  creator User @relation(fields: [createdBy], references: [id])

  @@index([createdBy])
  @@index([type])
  @@index([category])
  @@index([isActive])
}

model DecorAsset {
  id        Int    @id @default(autoincrement())
  createdBy Int
  type      String
  category  String?
  name      String
  url       String
  publicId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  creator User @relation(fields: [createdBy], references: [id])

  @@index([createdBy])
  @@index([type])
}

model Supplier {
  id          Int      @id @default(autoincrement())
  name        String
  contact     String
  email       String
  totalDebt   Float    @default(0)
  overdueDebt Float    @default(0)
  monthDebt   Float    @default(0)
  lastPaymentDate DateTime?
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  banned            Boolean   @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  supplierOptions SupplierOption[]
  orders Order[]
  expenses       Expense[]
}

// Source of truth cho mọi option (paperSize / paper / cover) của từng supplier.
model SupplierOption {
  id          Int      @id @default(autoincrement())
  supplierId  Int
  type        String // "paperSize" | "paper" | "cover"
  code        String
  name        Json
  description Json     @default("{}")
  width       Int?    // paperSize: kích thước thật (mm) để studio tính canvas
  height      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDelete    Boolean  @default(false)
  deletedAt   DateTime?

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@unique([supplierId, type, code])
  @@index([type])
  @@index([isDelete])
}

model Coupon {
  id                Int       @id @default(autoincrement())
  code              String    @unique
  scope             String    @default("ORDER")   // ORDER (toàn đơn) | ITEM (theo từng quyển)
  discountType      String
  discountValue     Float
  minOrderAmount    Float     @default(0)
  maxDiscountAmount Float?
  maxUsageCount     Int       @default(0)
  usedCount         Int       @default(0)
  isActive          Boolean   @default(true)
  expiresAt         DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  orders            Order[]
  usage             CouponUsage[]

  @@index([isActive])
  @@index([expiresAt])
}

model CouponUsage {
  id       Int      @id @default(autoincrement())
  couponId Int
  userId   Int
  usedAt   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  coupon   Coupon   @relation(fields: [couponId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([couponId, userId])
  @@index([userId])
}

model Expense {
  id           Int              @id @default(autoincrement())
  amount       Float
  category     ExpenseCategory
  description  String?          // nội dung chi
  date         DateTime
  paymentMethod String?
  supplierId   Int?
  orderId      Int?
  note         String?
  createdBy    Int
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  isDelete     Boolean          @default(false)
  deletedAt    DateTime?

  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  order       Order?    @relation(fields: [orderId], references: [id])
  creator     User      @relation(fields: [createdBy], references: [id])

  @@index([date])
  @@index([category])
  @@index([supplierId])
  @@index([createdBy])
}

model Cashflow {
  id          Int      @id @default(autoincrement())
  month       String   @unique   // "2026-07"
  totalIncome Float    @default(0)
  totalExpense Float   @default(0)
  netAmount   Float    @default(0)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([month])
}
