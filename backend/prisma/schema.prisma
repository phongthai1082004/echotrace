generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int     @id @default(autoincrement())
  email    String? @unique
  password String?
  name     String?
  avatar   String?
  phone    String?
  address  String?
  city     String?
  status   String?
  role     String  @default("user")
  googleId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  tokens      Token[]
  orders      Order[]
  userImages  UserImage[]
  books       Book[]
  couponUsage CouponUsage[]

  @@index([status])
  @@index([role])
  @@index([isDelete])
}

model Token {
  id           Int      @id @default(autoincrement())
  userId       Int?
  email        String?
  refreshToken String   @unique
  tokenType    String   @default("session")
  isRevoked    Boolean  @default(false)
  expiresAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  user         User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([email])
  @@index([expiresAt])
}

model UserImage {
  id       Int    @id @default(autoincrement())
  userId   Int
  url      String
  publicId String
  width    Int?
  height   Int?
  size     Int?
  bookId   Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  user     User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([bookId])
}

model Order {
  id             Int      @id @default(autoincrement())
  orderCode      String?
  userId         Int
  totalAmount    Float
  depositInput   Float    @default(0)
  paidAmount     Float    @default(0)
  paymentMethod  String   @default("FULL")
  payosOrderCode Int?     @unique
  status         String   @default("PENDING_PAYMENT")
  name           String?
  phone          String?
  address        String?
  city           String?
  note           String?
  couponId       Int?
  discountAmount Float    @default(0)
  timeline       String?
  productionBatchId Int?
  product        String?
  coverType      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  user         User              @relation(fields: [userId], references: [id])
  coupon       Coupon?           @relation(fields: [couponId], references: [id])
  productionBatch ProductionBatch? @relation(fields: [productionBatchId], references: [id])
  transactions Transaction[]
  orderItems   OrderItem[]

  @@index([userId])
  @@index([couponId])
  @@index([status])
  @@index([orderCode])
  @@index([productionBatchId])
}

model Transaction {
  id              Int      @id @default(autoincrement())
  orderId         Int
  payosOrderCode  Int      @unique
  amount          Float
  paymentLinkId   String
  reference       String?
  status          String
  transactionTime DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  order           Order    @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
}

model OrderItem {
  id       Int   @id @default(autoincrement())
  orderId  Int
  bookId   Int
  quantity Int   @default(1)
  price    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  order    Order @relation(fields: [orderId], references: [id])
  book     Book  @relation(fields: [bookId], references: [id])

  @@index([orderId])
  @@index([bookId])
}

model Book {
  id       Int     @id @default(autoincrement())
  userId   Int
  themeId  Int?
  type     String  @default("TRAVEL")
  title    String
  style    String
  font     String
  cover    String  @default("softcover")
  pages    Int     @default(0)
  coverUrl String?
  status   String  @default("DRAFT")
  content  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  user       User        @relation(fields: [userId], references: [id])
  theme      Theme?      @relation(fields: [themeId], references: [id])
  orderItems OrderItem[]

  @@index([userId])
  @@index([themeId])
  @@index([type])
  @@index([status])
}

model Theme {
  id           Int     @id @default(autoincrement())
  name         String
  code         String  @unique
  description  String
  category     String?
  thumbnailUrl String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  books        Book[]
  sampleBooks  SampleBook[]

  @@index([category])
}

model SampleBook {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  themeId     Int?
  type        String  @default("TRAVEL")
  category    String?
  style       String
  font        String
  cover       String  @default("softcover")
  pageCount   Int     @default(0)
  coverUrl    String?
  price       Float   @default(0)
  isActive    Boolean @default(true)
  content     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  theme       Theme? @relation(fields: [themeId], references: [id])

  @@index([themeId])
  @@index([type])
  @@index([category])
  @@index([isActive])
}

model DecorAsset {
  id       Int    @id @default(autoincrement())
  type     String
  category String?
  name     String
  url      String
  publicId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  @@index([type])
}

model Supplier {
  id          Int      @id @default(autoincrement())
  name        String
  contact     String
  email       String
  status      String   @default("active")
  totalDebt   Float    @default(0)
  overdueDebt Float    @default(0)
  monthDebt   Float    @default(0)
  lastPaymentDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  productionBatches ProductionBatch[]
}

model ProductionBatch {
  id          Int      @id @default(autoincrement())
  supplierId  Int
  code        String   @unique
  status      String   @default("pending")
  totalAmount Float    @default(0)
  notes       String?
  assignedAt  DateTime @default(now())
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  supplier Supplier @relation(fields: [supplierId], references: [id])
  orders   Order[]

  @@index([supplierId])
  @@index([status])
}

model Coupon {
  id                Int       @id @default(autoincrement())
  code              String    @unique
  discountType      String
  discountValue     Float
  minOrderAmount    Float     @default(0)
  maxDiscountAmount Float?
  maxUsageCount     Int       @default(0)
  usedCount         Int       @default(0)
  isActive          Boolean   @default(true)
  expiresAt         DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  orders            Order[]
  usage             CouponUsage[]

  @@index([isActive])
  @@index([expiresAt])
}

model CouponUsage {
  id       Int      @id @default(autoincrement())
  couponId Int
  userId   Int
  usedAt   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  coupon   Coupon   @relation(fields: [couponId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([couponId, userId])
  @@index([userId])
}
