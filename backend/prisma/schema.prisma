generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ExpenseCategory {
  OPERATING  
  PAYROLL   
  MARKETING 
  DEBT      
  OTHER
}

enum SampleBookType {
  ALBUM
  TEMPLATE
}

model User {
  id       Int     @id @default(autoincrement())
  email    String? @unique
  password String?
  name     String?
  avatar   String?
  phone    String?
  address  String?
  city     String?
  role     String  @default("user")
  googleId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  tokens      Token[]
  orders      Order[]
  userImages  UserImage[]
  books       Book[]
  sampleBooks SampleBook[]
  decorAssets DecorAsset[]
  cart        Cart?

  @@index([role])
  @@index([isDelete])
}

model Token {
  id           Int      @id @default(autoincrement())
  userId       Int?
  email        String?
  refreshToken String   @unique
  tokenType    String   @default("session")
  isRevoked    Boolean  @default(false)
  expiresAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  user         User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([email])
  @@index([expiresAt])
}

model UserImage {
  id       Int    @id @default(autoincrement())
  userId   Int
  url      String
  publicId String
  width    Int?
  height   Int?
  size     Int?
  bookId   Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  user     User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([bookId])
}

model Order {
  id             Int      @id @default(autoincrement())
  orderCode      String?
  userId         Int
  supplierId     Int?
  subTotal       Float
  totalAmount    Float
  depositAmount  Float    @default(0)
  paidAmount     Float    @default(0)
  paymentType    String   @default("FULL")
  paymentStatus  String   @default("UNPAID")
  status         String   @default("PENDING_PAYMENT")
  name           String?
  phone          String?
  address        String?
  city           String?
  note           String?
  couponCode     String?
  discountAmount Float    @default(0)
  orderShippingFee    Float?   
  supplierShippingFee Float?   
  trackingCode      String?
  orderItems     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  user         User          @relation(fields: [userId], references: [id])
  supplier     Supplier?     @relation(fields: [supplierId], references: [id])
  transactions Transaction[]

  @@index([userId])
  @@index([supplierId])
  @@index([status])
  @@index([paymentStatus])
  @@index([orderCode])
  @@index([trackingCode])
}

// gateway: PAYOS | SEPAY | MANUAL | CASH ...
// type: DEPOSIT | REMAINING_PAYMENT | FULL_PAYMENT | EXPENSE
model Transaction {
  id                     Int      @id @default(autoincrement())
  orderId                Int?
  idempotencyKeyId       String?  @unique
  gateway                String
  gatewayTransactionCode String?  @unique
  type                   String   @default("FULL_PAYMENT")
  amount                 Float
  paymentLinkId          String?
  bankAccount            String?
  content                String?
  reference              String?
  status                 String
  transactionTime        DateTime
  rawPayload             Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  order           Order?          @relation(fields: [orderId], references: [id])
  idempotencyKey  IdempotencyKey? @relation(fields: [idempotencyKeyId], references: [key])
  income          Income?
  expense         Expense?

  @@index([orderId])
  @@index([status])
  @@index([gateway])
  @@index([type])
}

// Nguồn tiền thu vào — chỉ tạo khi transaction SUCCESS.
model Income {
  id            Int      @id @default(autoincrement())
  transactionId Int      @unique
  amount        Float
  receivedAt    DateTime
  note          String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  transaction Transaction @relation(fields: [transactionId], references: [id])
  cashflow    Cashflow?

  @@index([receivedAt])
}

// Tiền chi ra — đứng độc lập, chỉ nối 1-1 với transaction.
model Expense {
  id            Int              @id @default(autoincrement())
  transactionId Int              @unique
  amount        Float
  category      ExpenseCategory
  description   String?
  date          DateTime
  supplierName  String?
  supplierInfo  Json?            // snapshot nhà cung cấp — document linh hoạt theo type (taxCode, bank, contact...)
  taxCode       String?          // trích từ supplierInfo khi tạo expense, để query nhanh
  note          String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  transaction Transaction @relation(fields: [transactionId], references: [id])
  cashflow    Cashflow?

  @@index([date])
  @@index([category])
  @@index([taxCode])
}

// Log dòng tiền — 1-1 với income hoặc expense.
model Cashflow {
  id        Int      @id @default(autoincrement())
  type      String   // "INCOME" | "EXPENSE"
  incomeId  Int?     @unique
  expenseId Int?     @unique
  amount    Float
  date      DateTime
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  income  Income?  @relation(fields: [incomeId], references: [id])
  expense Expense? @relation(fields: [expenseId], references: [id])

  @@index([type])
  @@index([date])
}

// orderItems: JSON snapshot of books at order time, like Cart.items.
// OrderItem table was replaced by this column — one row per order, items stored as JSON string.
model Book {
  id          Int     @id @default(autoincrement())
  userId      Int
  type        String  @default("TRAVEL")
  title       String
  style       String
  font        String
  cover       String  @default("softcover")
  coverUrl    String?
  paperHeight Float?
  paperWidth  Float?

  content   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  user       User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  items     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model IdempotencyKey {
  key          String   @id
  status       String @default("PROCESSING")
  responseBody Json?
  createdAt    DateTime @default(now())

  transaction Transaction?

  @@index([createdAt])
}

model SampleBook {
  id          Int     @id @default(autoincrement())
  createdBy   Int
  name        String
  description String?
  type        SampleBookType @default(TEMPLATE)
  category    String?
  quantity    Int?
  style       String
  font        String
  cover       String  @default("softcover")
  coverUrl    String?
  paperHeight Float?
  paperWidth  Float?
  isActive    Boolean @default(true)
  status      String  @default("draft")
  content     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  creator User @relation(fields: [createdBy], references: [id])

  @@index([createdBy])
  @@index([type])
  @@index([category])
  @@index([isActive])
}

model DecorAsset {
  id        Int    @id @default(autoincrement())
  createdBy Int
  type      String
  category  String?
  name      String
  url       String
  publicId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  creator User @relation(fields: [createdBy], references: [id])

  @@index([createdBy])
  @@index([type])
}

model Supplier {
  id          Int      @id @default(autoincrement())
  name        String
  contact     String
  email       String
  taxCode     String?          // Mã số thuế (VAT / GTGT)
  address     String?          // Địa chỉ đăng ký kinh doanh
  bankName          String?
  bankBin           String?    // Mã BIN ngân hàng (payout)
  bankAccountNumber String?
  bankAccountName   String?
  contactPerson     String?    // Người liên hệ
  totalDebt   Float    @default(0)
  overdueDebt Float    @default(0)
  monthDebt   Float    @default(0)
  lastPaymentDate DateTime?
  banned            Boolean   @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  supplierOptions SupplierPrintOption[]
  orders          Order[]
}

// Danh mục option in chung (toàn cục). Giá dùng chung cho mọi supplier.
model PrintOption {
  id          Int      @id @default(autoincrement())
  type        String // "paperSize" | "paper" | "cover"
  code        String
  name        Json
  description Json     @default("{}")
  width       Int?    // paperSize: kích thước thật (mm) để studio tính canvas
  height      Int?
  price       Float?  // giá (VND) — dùng chung cho mọi supplier
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  supplierOptions SupplierPrintOption[]

  @@unique([type, code])
  @@index([type])
  @@index([isDelete])
}

// Nối supplier ↔ PrintOption (chỉ quan hệ, không có dữ liệu riêng).
model SupplierPrintOption {
  id            Int       @id @default(autoincrement())
  supplierId    Int
  printOptionId Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isDelete      Boolean   @default(false)
  deletedAt     DateTime?

  supplier    Supplier   @relation(fields: [supplierId], references: [id])
  printOption PrintOption @relation(fields: [printOptionId], references: [id])

  @@unique([supplierId, printOptionId])
  @@index([printOptionId])
}

model Coupon {
  id                Int       @id @default(autoincrement())
  code              String    @unique
  scope             String    @default("ORDER")   // ORDER (toàn đơn) | ITEM (theo từng quyển)
  discountType      String
  discountValue     Float
  minOrderAmount    Float     @default(0)
  maxDiscountAmount Float?
  maxUsageCount     Int       @default(0)
  usedCount         Int       @default(0)
  isActive          Boolean   @default(true)
  expiresAt         DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  @@index([isActive])
  @@index([expiresAt])
}
