generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ExpenseCategory {
  OPERATING  
  PAYROLL   
  MARKETING 
  DEBT      
  OTHER
  SUPPLIER
  DEFECTIVE
}

enum SampleBookType {
  ALBUM
  TEMPLATE
}

model User {
  id       Int     @id @default(autoincrement())
  email    String? @unique
  password String?
  name     String?
  avatar   String?
  phone    String? @unique
  address  String?
  city     String?
  role     String  @default("user")
  googleId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  // ponytail: first-touch marketing attribution, write-once (null mới ghi)
  firstUtmSource   String?
  firstUtmMedium   String?
  firstUtmCampaign String?

  tokens      Token[]
  orders      Order[]
  userImages  UserImage[]
  books       Book[]
  sampleBooks SampleBook[]
  decorAssets DecorAsset[]
  cart        Cart?
  notifications Notification[]

  // ponytail: giữ role (giá trị hiếm admin=~0.1%, planner dùng được);
  // isDelete boolean bị bỏ (selectivity kém, chỉ tốn chi phí ghi).
  @@index([role])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  sendBy    String  @default("system")
  type      String  @default("info")
  channels  String[] @default([])
  // ponytail: personal = 1 user, broadcast = toàn bộ (500 rows/đợt, vài ms)
  scope     String  @default("personal")
  email     String?
  phone     String?
  metadata  Json?
  // ponytail: bản dịch title/message {title:{vi,en,es},message:{...}} — cột riêng,
  // không nhét vào metadata (metadata giữ cho actionUrl/orderId/dispatch data).
  i18n      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, scope])
}

model Token {
  id           Int      @id @default(autoincrement())
  userId       Int?
  email        String?
  refreshToken String   @unique
  tokenType    String   @default("session")
  isRevoked    Boolean  @default(false)
  expiresAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([email])
  @@index([expiresAt])
}

model UserImage {
  id       Int    @id @default(autoincrement())
  userId   Int
  url      String
  publicId String
  width    Int?
  height   Int?
  size     Int?
  thumbUrl String?
  bookId   Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  user     User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([bookId])
}

enum ReturnState {
  none
  requested
  approved
  reshipping
  reshipped
  refunding
  refunded
}

enum DefectState {
  none
  reported
  resolved
}

enum ReturnFault {
  self
  supplier
}

model Order {
  id             Int      @id @default(autoincrement())
  orderCode      String? @unique
  userId         Int
  supplierId     Int?
  subTotal       Float
  totalAmount    Float
  depositAmount  Float    @default(0)
  paidAmount     Float    @default(0)
  paymentType    String   @default("full-payment")
  status         String   @default("pending_payment")
  name           String?
  phone          String?
  address        String?
  city           String?
  note           String?
  couponCode     String?
  discountAmount Float    @default(0)
  orderShippingFee    Float?   
  supplierShippingFee Float?   
  trackingCode      String? @unique
  codReconciledAt DateTime?
  qrCode        String?
  checkoutUrl   String?
  expiredAt     DateTime?
  orderItems     Json?
  pdfUrl         String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  returnState  ReturnState? @default(none)
  returnFault  ReturnFault?
  returnReason String?
  defectState  DefectState? @default(none)

  // ponytail: snapshot UTM copy server-side từ Book lúc tạo đơn — đơn bất biến
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  user         User          @relation(fields: [userId], references: [id])
  supplier     Supplier?     @relation(fields: [supplierId], references: [id])
  transactions Transaction[]
  pdfJobs       OrderPdfJob[]

  @@index([userId])
  @@index([supplierId])
}

model OrderPdfJob {
  id         Int       @id @default(autoincrement())
  orderId    Int       @unique
  status     String    @default("PENDING")
  pdfUrl     String?
  attempts   Int       @default(0)
  lastError  String?
  lockedAt   DateTime?
  processedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

}

model Transaction {
  id                     Int      @id @default(autoincrement())
  orderId                Int?
  idempotencyKeyId       String?  @unique
  gateway                String
  gatewayTransactionCode String?  @unique
  type                   String   @default("full_payment")
  amount                 Float
  paymentLinkId          String?
  bankAccount            String?
  content                String?
  reference              String?
  status                 String
  transactionTime        DateTime
  rawPayload             Json?
  reconciledAt           DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order           Order?          @relation(fields: [orderId], references: [id])
  idempotencyKey  IdempotencyKey? @relation(fields: [idempotencyKeyId], references: [key])
  income          Income?
  expenses        Expense[]

  @@index([orderId])
}

model Income {
  id            Int      @id @default(autoincrement())
  transactionId Int?     @unique
  orderId       Int?
  amount        Float
  receivedAt    DateTime
  note          String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transaction Transaction? @relation(fields: [transactionId], references: [id])
  cashflow    Cashflow?

  @@index([receivedAt])
  @@index([orderId])
}

model Expense {
  id            Int              @id @default(autoincrement())
  transactionId Int?
  orderId       Int?
  amount        Float
  category      ExpenseCategory
  description   String?
  date          DateTime
  supplierName  String?
  supplierInfo  Json?            
  taxCode       String?          
  note          String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transaction Transaction? @relation(fields: [transactionId], references: [id])
  cashflow    Cashflow?

  @@index([date])
  @@index([taxCode])
  @@index([orderId])
  @@index([transactionId])
}

model Cashflow {
  id            Int      @id @default(autoincrement())
  type          String   
  incomeId      Int?     @unique
  expenseId     Int?     @unique
  transactionId Int?
  orderId       Int?
  amount        Float
  date          DateTime
  note          String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  income  Income?  @relation(fields: [incomeId], references: [id])
  expense Expense? @relation(fields: [expenseId], references: [id])

  @@index([date])
  @@index([orderId])
  @@index([transactionId])
}

model Book {
  id          Int     @id @default(autoincrement())
  userId      Int
  type        String  @default("TRAVEL")
  title       String
  style       String
  font        String
  cover       String  @default("softcover")
  coverUrl    String?
  paperHeight Float?
  paperWidth  Float?

  content   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  // ponytail: UTM ghim lúc tạo sách — phiên design kéo dài nhiều ngày nên
  // attribution theo project, không theo session lúc thanh toán
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  sampleBookId Int?
  sampleBook   SampleBook? @relation(fields: [sampleBookId], references: [id])

  user       User        @relation(fields: [userId], references: [id])
  cartItems  CartItem[]

  @@index([userId])
  @@index([sampleBookId])
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id])
  items CartItem[]
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  bookId    Int
  quantity  Int      @default(1)
  cover     String?
  paper     String?
  paperSize String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([cartId, bookId])
  @@index([bookId])
}

model IdempotencyKey {
  key          String   @id
  status       String @default("PROCESSING")
  responseBody Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transaction Transaction?

  @@index([createdAt])
}

model SampleBook {
  id          Int     @id @default(autoincrement())
  createdBy   Int
  name        String
  description String?
  type        SampleBookType @default(TEMPLATE)
  category    String?
  quantity    Int?
  style       String
  font        String
  cover       String  @default("softcover")
  coverUrl    String?
  paperHeight Float?
  paperWidth  Float?
  isActive    Boolean @default(true)
  status      String  @default("draft")
  content     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  creator User @relation(fields: [createdBy], references: [id])
  books   Book[]

  @@index([createdBy])
}

model DecorAsset {
  id        Int    @id @default(autoincrement())
  createdBy Int
  type      String
  category  String?
  name      String
  url       String
  publicId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  creator User @relation(fields: [createdBy], references: [id])

  @@index([createdBy])
}

model Supplier {
  id          Int      @id @default(autoincrement())
  name        String
  contact     String
  email       String @unique
  taxCode     String?          
  address     String?          
  bankName          String?
  bankBin           String?    
  bankAccountNumber String?
  bankAccountName   String?
  contactPerson     String?    
  totalDebt   Float    @default(0)
  monthDebt   Float    @default(0)
  lastPaymentDate DateTime?
  banned            Boolean   @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  supplierOptions SupplierPrintOption[]
  orders          Order[]
}

model PrintOption {
  id          Int      @id @default(autoincrement())
  type        String 
  code        String
  name        Json
  description Json     @default("{}")
  width       Int?    
  height      Int?
  price       Float?  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  supplierOptions SupplierPrintOption[]

  @@unique([type, code])
}

model SupplierPrintOption {
  id            Int       @id @default(autoincrement())
  supplierId    Int
  printOptionId Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  supplier    Supplier   @relation(fields: [supplierId], references: [id])
  printOption PrintOption @relation(fields: [printOptionId], references: [id])

  @@unique([supplierId, printOptionId])
  @@index([printOptionId])
}

model Coupon {
  id                Int       @id @default(autoincrement())
  code              String    @unique
  discountType      String
  discountValue     Float
  minOrderAmount     Float     @default(0)
  minOrderType       String    @default("value")
  maxDiscountAmount Float?
  maxUsageCount     Int       @default(0)
  usedCount         Int       @default(0)
  isActive          Boolean   @default(true)
  expiresAt         DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  @@index([expiresAt])
}

// ponytail: bảng counter tài chính theo tháng, cập nhật bởi DB trigger.
// Schema (functions+triggers): prisma/triggers/finance_counters.sql (an toàn để paste vào migration).
// Backfill dữ liệu 1 lần (không phải schema): prisma/triggers/backfill_finance_periods.sql.
model FinancePeriod {
  period               String   @id // 'YYYY-MM'
  totalOrders          Int      @default(0)
  totalRevenue         Float    @default(0)
  totalExpense         Float    @default(0)
  totalSupplierExpense Float    @default(0)
  cashInflow           Float    @default(0)
  cashOutflow          Float    @default(0)
  totalProfit          Float    @default(0)
  cashOnHand           Float    @default(0)
  receivables          Float    @default(0)
  payables             Float    @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ponytail: cửa sổ bảo trì — 1 bảng vừa là cờ live (dòng scheduled/active mới
// nhất) vừa là lịch sử. Sống trong DB nên rebuild container/Redis reset không mất.
model MaintenanceWindow {
  id        Int      @id @default(autoincrement())
  startAt   DateTime
  endAt     DateTime? // null = bật tay, mở tới khi có người tắt
  reason    String?
  status    String   @default("scheduled") // scheduled|active|completed|cancelled
  createdBy Int?
  createdAt DateTime @default(now())
  endedAt   DateTime?
  endedBy   Int?
  // ponytail: đã bắn broadcast "đang bảo trì" chưa — guard chống bắn trùng
  // khi nhiều process cùng lật cửa sổ hẹn sang active
  notifiedAt DateTime?

}
