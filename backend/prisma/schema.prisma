generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int     @id @default(autoincrement())
  email    String? @unique
  password String?
  name     String?
  avatar   String?
  phone    String?
  address  String?
  city     String?
  status   String?
  role     String  @default("user")
  googleId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  tokens      Token[]
  orders      Order[]
  userImages  UserImage[]
  books       Book[]
  couponUsage CouponUsage[]
  sampleBooks SampleBook[]
  decorAssets DecorAsset[]
  cart        Cart?

  @@index([status])
  @@index([role])
  @@index([isDelete])
}

model Token {
  id           Int      @id @default(autoincrement())
  userId       Int?
  email        String?
  refreshToken String   @unique
  tokenType    String   @default("session")
  isRevoked    Boolean  @default(false)
  expiresAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  user         User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([email])
  @@index([expiresAt])
}

model UserImage {
  id       Int    @id @default(autoincrement())
  userId   Int
  url      String
  publicId String
  width    Int?
  height   Int?
  size     Int?
  bookId   Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  user     User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([bookId])
}

model Order {
  id             Int      @id @default(autoincrement())
  orderCode      String?
  userId         Int
  supplierId     Int?
  subTotal       Float
  totalAmount    Float
  depositAmount  Float    @default(0)
  paidAmount     Float    @default(0)
  paymentType    String   @default("FULL")
  paymentStatus  String   @default("UNPAID")
  status         String   @default("PENDING_PAYMENT")
  name           String?
  phone          String?
  address        String?
  city           String?
  note           String?
  couponId       Int?
  discountAmount Float    @default(0)
  timeline       String?
  product        String?
  coverType      String?
  orderShippingFee    Float?   
  supplierShippingFee Float?   
  trackingCode      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  user         User          @relation(fields: [userId], references: [id])
  supplier     Supplier?     @relation(fields: [supplierId], references: [id])
  coupon       Coupon?       @relation(fields: [couponId], references: [id])
  transactions Transaction[]
  orderItems   OrderItem[]

  @@index([userId])
  @@index([supplierId])
  @@index([couponId])
  @@index([status])
  @@index([paymentStatus])
  @@index([orderCode])
  @@index([trackingCode])
}

// gateway: PAYOS | SEPAY | MANUAL | CASH ...
// type: DEPOSIT | REMAINING_PAYMENT | FULL_PAYMENT
model Transaction {
  id                     Int      @id @default(autoincrement())
  orderId                Int
  gateway                String
  gatewayTransactionCode String   @unique
  type                   String   @default("FULL_PAYMENT")
  amount                 Float
  paymentLinkId          String?
  bankAccount            String?
  content                String?
  reference              String?
  status                 String
  transactionTime        DateTime
  rawPayload             String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  order           Order    @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@index([gateway])
  @@index([type])
}

model OrderItem {
  id       Int   @id @default(autoincrement())
  orderId  Int
  bookId   Int
  quantity Int   @default(1)
  price    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  order    Order @relation(fields: [orderId], references: [id])
  book     Book  @relation(fields: [bookId], references: [id])

  @@index([orderId])
  @@index([bookId])
}

model Book {
  id        Int     @id @default(autoincrement())
  userId    Int
  type      String  @default("TRAVEL")
  title     String
  style     String
  font      String
  cover     String  @default("softcover")
  coverPrice Float  @default(0)
  paperSize String?
  paperType String?
  paperPrice Float  @default(0)
  pages     Int     @default(0)
  coverUrl  String?
  status    String  @default("DRAFT")
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  user       User        @relation(fields: [userId], references: [id])
  orderItems OrderItem[]

  @@index([userId])
  @@index([type])
  @@index([status])
}

// Gio hang: moi User co 1 gio hang dang hoat dong.
// items: JSON string array of { bookId, quantity, price }, e.g. '[{"bookId":1,"quantity":1,"price":250000}]'
model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  items     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model SampleBook {
  id          Int     @id @default(autoincrement())
  createdBy   Int
  name        String
  description String?
  type        String  @default("TRAVEL")
  category    String?
  style       String
  font        String
  cover       String  @default("softcover")
  pageCount   Int     @default(0)
  coverUrl    String?
  price       Float   @default(0)
  isActive    Boolean @default(true)
  content     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  creator User @relation(fields: [createdBy], references: [id])

  @@index([createdBy])
  @@index([type])
  @@index([category])
  @@index([isActive])
}

model DecorAsset {
  id        Int    @id @default(autoincrement())
  createdBy Int
  type      String
  category  String?
  name      String
  url       String
  publicId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  creator User @relation(fields: [createdBy], references: [id])

  @@index([createdBy])
  @@index([type])
}

model Supplier {
  id          Int      @id @default(autoincrement())
  name        String
  contact     String
  email       String
  status      String   @default("active")
  totalDebt   Float    @default(0)
  overdueDebt Float    @default(0)
  monthDebt   Float    @default(0)
  lastPaymentDate DateTime?
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  orders Order[]
  supplierPapers SupplierPaper[]
  coverOptions   CoverOption[]
}

// Danh muc kho giay / loai giay ma supplier co the cung cap, kem gia
model SupplierPaper {
  id         Int      @id @default(autoincrement())
  supplierId Int
  paperSize  String
  paperType  String
  price      Float    @default(0)
  isActive   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@index([isActive])
}

// Danh muc loai bia (softcover, hardcover, leather...) ma supplier cung cap, kem gia
model CoverOption {
  id         Int     @id @default(autoincrement())
  supplierId Int
  name       String
  price      Float   @default(0)
  isActive   Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@unique([supplierId, name])
  @@index([supplierId])
  @@index([isActive])
}

model Coupon {
  id                Int       @id @default(autoincrement())
  code              String    @unique
  discountType      String
  discountValue     Float
  minOrderAmount    Float     @default(0)
  maxDiscountAmount Float?
  maxUsageCount     Int       @default(0)
  usedCount         Int       @default(0)
  isActive          Boolean   @default(true)
  expiresAt         DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  orders            Order[]
  usage             CouponUsage[]

  @@index([isActive])
  @@index([expiresAt])
}

model CouponUsage {
  id       Int      @id @default(autoincrement())
  couponId Int
  userId   Int
  usedAt   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDelete  Boolean  @default(false)
  deletedAt DateTime?

  coupon   Coupon   @relation(fields: [couponId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([couponId, userId])
  @@index([userId])
}
