{
	"name": "backend",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch --env-file=.env.development src/server.ts",
		"build": "tsc",
		"start": "node dist/src/server.js",
		"format": "prettier --write .",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"test:unit": "jest tests/unit",
		"test:integration": "set NODE_OPTIONS=--experimental-vm-modules&& jest --config jest.integration.config.ts --runInBand --forceExit",
		"type-check": "tsc --noEmit -p tsconfig.ci.json",
		"seed": "tsx --env-file=.env.development prisma/seed-admin.ts",
		"db:seed": "prisma db seed"
	},
	"dependencies": {
		"@echotrace/shared": "workspace:*",
		"@payos/node": "^2.0.5",
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"bcryptjs": "^2.4.3",
		"canvas": "^3.2.3",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"drizzle-orm": "1.0.0-rc.4",
		"express": "^5.2.1",
		"express-rate-limit": "^8.6.0",
		"fabric": "^7.4.0",
		"google-auth-library": "^10.9.0",
		"googleapis": "^180.0.0",
		"helmet": "^8.3.0",
		"i18next": "^26.3.4",
		"i18next-fs-backend": "^2.6.6",
		"i18next-http-middleware": "^3.9.7",
		"ioredis": "^6.0.0",
		"jsonwebtoken": "^9.0.3",
		"nodemailer": "^9.0.3",
		"pdf-lib": "^1.17.1",
		"pg": "^8.22.0",
		"reflect-metadata": "^0.2.2",
		"tsyringe": "^4.10.0",
		"wrangler": "^4.123.0"
	},
	"devDependencies": {
		"@jest/globals": "^29.7.0",
		"@types/bcryptjs": "^2.4.6",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jest": "^29.5.5",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.1.0",
		"@types/pg": "^8.20.0",
		"@types/supertest": "^2.0.12",
		"drizzle-kit": "1.0.0-rc.4",
		"jest": "^29.7.0",
		"jest-html-reporters": "^3.1.7",
		"jest-mock-extended": "^3.0.5",
		"nodemon": "^3.1.14",
		"prettier": "3.9.6",
		"prisma": "^7.8.0",
		"supertest": "^6.3.3",
		"ts-jest": "^29.1.1",
		"ts-node": "^10.9.2",
		"tsc-alias": "^1.9.4",
		"tsx": "^4.22.5",
		"typescript": "^6.0.3",
		"vitest": "^2.1.9"
	},
	"pnpm": {
		"overrides": {
			"react": "$react",
			"react-dom": "$react-dom"
		}
	},
	"prisma": {
		"seed": "tsx prisma/seed-admin.ts"
	}
}
