  "cards": [
    {
      "dot": "cyan",
      "title": "Payment truth",
      "items": [
        "Webhook verifies the PayOS HMAC before trusting the payload",
        "dupPaid guard + Serializable transaction prevent double counting",
        "verifyPayment polls PayOS as a fallback when webhooks are late"
      ]
    },
    {
      "dot": "emerald",
      "title": "Finance recognition",
      "items": [
        "Cashflow IN at webhook (real money received)",
        "Income at DELIVERED (revenue recognition, once)",
        "Refund reconcile records Cashflow OUT only (no Expense)",
        "Every row fires Postgres triggers → fn_period_upsert → FinancePeriod"
      ]
    }
  ]
