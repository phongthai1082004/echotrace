# =============================================================================
# FRONTEND DOCKERFILE
# Stage 1: deps    — install (no native build tools, frontend không dùng canvas)
# Stage 2: builder — build shared + next build
# Stage 3: runner  — standalone output only
# =============================================================================

FROM node:22-alpine AS deps
WORKDIR /app

# Canvas cần build tools dù là frontend (pnpm workspace install chung)
RUN apk add --no-cache python3 make g++ cairo-dev jpeg-dev pango-dev giflib-dev

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY shared/package.json ./shared/
COPY frontend/package.json ./frontend/

RUN --mount=type=cache,id=pnpm-store-frontend,target=/root/.local/share/pnpm/store \
    npm install -g pnpm@11.9.0 --registry https://registry.npmmirror.com && \
    pnpm config set registry https://registry.npmmirror.com && \
    pnpm install --frozen-lockfile --filter echotrace...

# =============================================================================

FROM node:22-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/ ./
COPY shared/ ./shared/
COPY frontend/ ./frontend/

ARG NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
ENV NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL

RUN npm install -g pnpm@11.9.0 --registry https://registry.npmmirror.com && \
    pnpm --filter @echotrace/shared build && \
    pnpm --filter echotrace build

# =============================================================================

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 NEXT_TELEMETRY_DISABLED=1

COPY --from=builder /app/frontend/.next/standalone ./
COPY --from=builder /app/frontend/.next/static ./frontend/.next/static
COPY --from=builder /app/frontend/public ./frontend/public

EXPOSE 3000
CMD ["node", "frontend/server.js"]
