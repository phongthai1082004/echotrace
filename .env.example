# =============================================================================
# ENV EXAMPLE — Root environment file for docker-compose
# Copy to .env and fill in POSTGRES_PASSWORD
# =============================================================================

# --- POSTGRES (local Docker container — override.yml uses these) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=echotrace
POSTGRES_PORT=5432

# --- DATABASE ---
DATABASE_URL=

# --- ENV FILE PATHS (tells docker-compose which .env files to load per service) ---
BACKEND_ENV_FILE=./backend/.env.development
FRONTEND_ENV_FILE=./frontend/.env.development

# --- PORTS ---
BACKEND_PORT=4000
FRONTEND_PORT=3000
REDIS_PORT=6379
NGINX_PORT=80

# --- HOSTS (Docker internal service names) ---
BACKEND_HOST=backend-service
FRONTEND_HOST=frontend-service
REDIS_HOST=redis-service

# --- PUBLIC URLS (used by frontend at build time) ---
NEXT_PUBLIC_BACKEND_URL=

# --- NGINX ---
SERVER_DOMAIN=localhost

# --- GA4 DATA API (admin marketing page; optional — page shows DB numbers without it) ---
# GA_PROPERTY_ID=
# GA_CREDENTIALS_PATH=

