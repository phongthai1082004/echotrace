{
  "compilerOptions": {
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["backend/src/*"],
      "@features/*": ["backend/src/features/*"],
      "@middleware/*": ["backend/src/middleware/*"],
      "@lib/*": ["backend/src/lib/*"],
      "@utils/*": ["backend/src/utils/*"],
      "@di/*": ["backend/src/di/*"],
      "@echotrace/shared": ["shared/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "frontend/node_modules", "backend/node_modules"]
}
