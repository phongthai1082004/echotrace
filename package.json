{
  "name": "echotrace-root",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter @echotrace/shared build && pnpm --parallel dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter backend exec prisma generate",
    "db:push": "pnpm --filter backend exec prisma db push",
    "db:studio": "pnpm --filter backend exec prisma studio",
    "seed": "pnpm --filter backend exec tsx prisma/seed-admin.ts"
  },
  "devDependencies": {
    "prisma": "^7.8.0"
  },
  "overrides": {
    "uuid": "^10.0.0",
    "glob": "^11.0.0",
    "react-popper>react": "^19.0.0",
    "react-popper>react-dom": "^19.0.0",
    "i18next": "$i18next"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": ["react", "react-dom"],
      "allowAny": ["react", "react-dom"]
    }
  }
}
